#!/bin/sh
# Login banner for the RECOVERY slot (p7).
#
# The A/B banner's job is to tell you which slot you are on. This one has a
# blunter job: make it impossible to spend ten minutes debugging before
# realising you are not on the slot you thought you were. Recovery has no
# overlay, no A/B semantics, and nothing you change here survives a normal
# boot -- so it says that, in red, every time.
set -u

if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    C_RST=$(printf '\033[0m');    C_DIM=$(printf '\033[2m')
    C_RED=$(printf '\033[1;31m'); C_YEL=$(printf '\033[1;33m')
    C_GRN=$(printf '\033[1;32m'); C_WHT=$(printf '\033[1;37m')
else
    C_RST=''; C_DIM=''; C_RED=''; C_YEL=''; C_GRN=''; C_WHT=''
fi

printf '%s' "$C_RED"
cat <<'ART'
  ▄▄▄▄  ▄▄▄▄  ▄▄▄  ▄▄▄▄ ▄▄  ▄▄ ▄▄▄▄ ▄▄▄▄ ▄▄  ▄▄
  ██  █ ██    ██   ██ █ ██  ██ ██   ██ █ ██  ██   O M N I
  ██▀▀▄ ████  ██   ██ █ ██  ██ ████ ██▀▄  ████
  ██  █ ██▄▄▄ ██▄▄ ██▄█  ████  ██▄▄ ██ █   ██     R E C O V E R Y
ART
printf '%s' "$C_RST"

why=$(sed -n 's/.*\(factory_reset\|hard_recovery\).*/\1/p' /proc/cmdline 2>/dev/null | head -1)
run=$(sed -n 's/.*root=\/dev\/mmcblk0p\([0-9]\).*/\1/p' /proc/cmdline 2>/dev/null)

printf '\n  %sTHIS IS THE RECOVERY SLOT (p%s). It is not an A/B slot.%s\n' \
    "$C_RED" "${run:-7}" "$C_RST"
printf '  %sNothing you change here survives a normal boot.%s\n\n' "$C_DIM" "$C_RST"

printf '  %s%-10s%s %s\n' "$C_DIM" "reason" "$C_RST" "${why:-unknown}"
printf '  %s%-10s%s %s\n' "$C_DIM" "kernel" "$C_RST" "$(uname -r)"

if command -v fw_printenv >/dev/null 2>&1; then
    ptr=$(fw_printenv -n mender_boot_part 2>/dev/null || echo '?')
    fhr=$(fw_printenv -n force_hard_recovery 2>/dev/null || echo '<undefined>')
    printf '  %s%-10s%s p%s %s(where a normal boot goes)%s\n' "$C_DIM" "a/b slot" "$C_RST" "$ptr" "$C_DIM" "$C_RST"
    case "$fhr" in
    0|'<undefined>')
        printf '  %s%-10s%s %sdisarmed%s - reboot returns to p%s\n' \
            "$C_DIM" "recovery" "$C_RST" "$C_GRN" "$C_RST" "$ptr" ;;
    *)
        printf '  %s%-10s%s %sSTILL ARMED (force_hard_recovery=%s)%s\n' \
            "$C_DIM" "recovery" "$C_RST" "$C_RED" "$fhr" "$C_RST"
        printf '  %s%-10s%s %severy reboot returns HERE until you clear it:%s\n' \
            "$C_DIM" "" "$C_RST" "$C_YEL" "$C_RST"
        printf '  %s%-10s%s   /usr/lib/omni/omni-recovery-disarm\n' "$C_DIM" "" "$C_RST" ;;
    esac
fi

nic=$(ls /sys/class/net 2>/dev/null | grep -vx lo | head -1)
if [ -n "$nic" ]; then
    ip=$(ip -4 -o addr show dev "$nic" 2>/dev/null | awk '{print $4}' | head -1)
    printf '  %s%-10s%s %s %s\n' "$C_DIM" "net" "$C_RST" "$nic" "${ip:-no address}"
fi
if command -v tailscale >/dev/null 2>&1; then
    tsip=$(tailscale ip -4 2>/dev/null | head -1)
    printf '  %s%-10s%s %s\n' "$C_DIM" "tailscale" "$C_RST" "${tsip:-not connected}"
fi

printf '\n  %sTo repair a slot:%s omni-flash.sh --slot 1|2 --image URL --sha256 X --size N\n' "$C_WHT" "$C_RST"
printf '  %sThen:%s reboot   (recovery disarms itself; you land back on the A/B slot)\n\n' "$C_WHT" "$C_RST"
