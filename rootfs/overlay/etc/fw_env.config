# /etc/fw_env.config -- where fw_printenv / fw_setenv find the U-Boot env.
#
# Copied verbatim from the Yocto firmware:
#   repo/meta-apollo/recipes-bsp/u-boot-apollo/files/fw_env.config
#
#   MTD device name / block device   Device offset   Env. size   Flash sector size
#
# This is ONE non-redundant 8 KB copy at offset 0 of the eMMC boot0 hardware
# partition (patch 0036 removed CONFIG_ENV_OFFSET_REDUND).  There is no second
# copy and no canary: a torn write here is unrecoverable in-band and needs the
# serial "=>" prompt plus an mmc write from omni-boot0.img.
#
# /dev/mmcblk0boot0 is read-only by default.  Every write must be wrapped in:
#     echo 0 > /sys/block/mmcblk0boot0/force_ro
#     fw_setenv ...
#     echo 1 > /sys/block/mmcblk0boot0/force_ro
# /usr/lib/omni/omni-uboot-env.sh does this (and restores force_ro on any exit).
#
# If Phase 0 finds a different layout on the device, THIS FILE must be updated
# to match -- the helpers derive the force_ro sysfs node from the device named
# on the first non-comment line below.
/dev/mmcblk0boot0	0x0000	0x2000	0x2000
