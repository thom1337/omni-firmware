build/*
.prepare

# Sparse mainline kernel checkout fetched by tools/validate-dts.sh
/.cache/

# Rootfs build artifacts
/rootfs/out/
*.ext4
*.ext4.gz

# Editor / OS noise
*.swp
*~
.DS_Store

# rootfs builder (rootfs/build-rootfs.sh) scratch and inputs
/rootfs/.work/
/rootfs/kernel-debs/

# Whole-eMMC images pulled off devices by tools/omni-backup.sh. These are 4 GB
# each before compression and they contain the U-Boot environment, which holds
# the board's MAC address and the Tailscale node state on /data -- so they are
# both far too large and far too sensitive to ever land in a commit.
/omni-backups/

# Python bytecode from the serial-console tools
__pycache__/
*.pyc

# Claude Code local overrides (machine-specific: jumphost address for the Omni serial console)
.claude/settings.local.json
