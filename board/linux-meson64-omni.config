# ==============================================================================
#  Avast Omni - kernel config DELTA over Armbian's stock meson64 config
# ==============================================================================
#
#  THIS FILE IS A FRAGMENT, NOT A COMPLETE .config.
#
#  Armbian has no fragment-merge mechanism: it copies
#  userpatches/config/kernel/${LINUXCONFIG}.config over the kernel's .config
#  wholesale (lib/functions/compilation/kernel-config.sh:17-19,69) and then runs
#  `make olddefconfig`. Dropping this file there verbatim would therefore throw
#  away the entire stock config.
#
#  tools/sync-armbian-board.sh does the merge: it takes
#    armbian/config/kernel/linux-meson64-oldlts.config   (the stock defconfig)
#  strips every symbol named below out of it, appends the normalised lines from
#  this file, and writes the result to
#    armbian/userpatches/config/kernel/linux-meson64-oldlts.config
#  The trailing "# ..." comments on each line are STRIPPED during that merge
#  (kconfig has no trailing-comment syntax) - they exist for humans and for
#  tools/check-kconfig-invariants.sh, which asserts these values in CI.
#
#  EDITING RULE: never start a prose comment line with "# CONFIG_<SYM> is not
#  set". The merger treats exactly that shape as a real "disable this symbol"
#  directive no matter where it appears. Write "PANIC_ON_OOPS", not
#  "CONFIG_PANIC_ON_OOPS", when you are talking about an option rather than
#  setting it.
#
#  "Armbian stock:" notes below were read out of
#    armbian/build main @ 587b6f2c :: config/kernel/linux-meson64-oldlts.config
#  (a `make savedefconfig` minimal defconfig, 4133 lines - a symbol that is
#  absent there is either at its Kconfig default or implied by a select) and out
#  of lib/functions/compilation/armbian-kernel.sh, which mutates .config with
#  ./scripts/config AFTER this file is copied in. Anything armbian-kernel.sh
#  forces cannot be overridden from this file - see the two callouts below.
#
#  Armbian's meson64 config is identical on oldlts (6.12) and current (6.18) for
#  every symbol in this file, so this delta transfers unchanged to a 6.18 pin.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Ethernet PHY - the single most important line in this file
# ------------------------------------------------------------------------------
# The Omni's NIC is an RTL8211F on RGMII. Armbian's meson64 config enables
# ICPLUS_PHY (for JetHub's 100 Mbit RMII part) and has no Realtek PHY driver at
# all. Without realtek.ko the link still comes up, on genphy: no RGMII TX/RX
# delay programming, no access to the paged 0xd08 registers, no EEE/ALDPS
# handling. That is "gigabit that mostly works" - it passes a casual ping and
# fails an asymmetric per-direction iperf3. Built-in rather than =m so the PHY
# is bound during rootfs mount, before any module can be loaded.
CONFIG_REALTEK_PHY=y                    # Armbian stock: ABSENT. Essential. Risk #3 in the plan.

# ------------------------------------------------------------------------------
# 2. Root filesystem and the A/B overlay
# ------------------------------------------------------------------------------
# !! CANNOT WIN FROM THIS FILE ALONE !!
# armbian_kernel_config__enable_docker_support() (armbian-kernel.sh:538) does
# opts_m+=("OVERLAY_FS"), and armbian_kernel_config_apply_opts_from_arrays()
# applies opts_n, then opts_y, then opts_m, then opts_val - so its =m runs after
# and beats anything written here. board/post_family_config__avast-omni.sh
# therefore also sets opts_val["OVERLAY_FS"]="y", which is applied last.
# Built-in matters because the overlay is mounted from
# /etc/initramfs-tools/scripts/local-bottom/omni-overlay; =m makes a bootable
# root depend on overlay.ko having been copied into the initramfs correctly.
CONFIG_OVERLAY_FS=y                     # Armbian stock: =m (forced =m by armbian-kernel.sh:538; see the hook)

# Root, both A/B slots, /data and both overlay uppers are ext4. The stock
# defconfig has no CONFIG_EXT4_FS line because CONFIG_EXT3_FS=y `select`s it
# (fs/ext4/Kconfig:5-7), and armbian_kernel_config__enable_various_filesystems()
# (armbian-kernel.sh:462) forces it =y anyway. Listed so CI asserts it directly
# instead of trusting two layers of indirection.
CONFIG_EXT4_FS=y                        # Armbian stock: implied (EXT3_FS=y selects it) + forced =y by armbian-kernel.sh:462

# eMMC controller. Built-in, or there is no root device to mount from.
CONFIG_MMC_MESON_GX=y                   # Armbian stock: =y already. Invariant only.

# ------------------------------------------------------------------------------
# 3. Panic behaviour - this is what makes bootcount rollback fire
# ------------------------------------------------------------------------------
# U-Boot's bootlimit/altbootcmd rollback only helps if something reboots the
# box. Nothing else will: the Omni is headless, in a closet, with no remote
# power. The 5.4 vendor kernel sets PANIC_TIMEOUT=15 and PANIC_ON_OOPS=y
# (repo/meta-apollo/recipes-kernel/linux/files/defconfig:335-336),
# so it reboots 15 s after a panic today. Mainline defaults PANIC_TIMEOUT to 0 =
# hang forever (lib/Kconfig.debug:1056-1058) and Armbian leaves both unset, so a
# stock-config mainline kernel would LOSE a safety property the current firmware
# has. `panic=10` on the cmdline is belt-and-braces, not the primary mechanism.
CONFIG_PANIC_TIMEOUT=15                 # Armbian stock: ABSENT (Kconfig default 0 = hang forever). Recovery-ladder rank 4.
CONFIG_PANIC_ON_OOPS=y                  # Armbian stock: ABSENT (Kconfig default n). Matches 5.4 defconfig:335.

# Ramoops/pstore over the reserved region carried forward from vendor patch 0012
# (node renamed ramoops@f400000 to match its own reg). Built-in, not =m: a panic
# that happens before the module loads is exactly the panic worth recording, and
# "no pstore records" is a Phase 9 soak criterion.
CONFIG_PSTORE=y                         # Armbian stock: implied only (ACPI_APEI=y `select PSTORE`, apei/Kconfig:11). Asserted explicitly so an ACPI change cannot silently take pstore with it.
CONFIG_PSTORE_RAM=y                     # Armbian stock: =m. Needs to be built-in to catch early panics.

# ------------------------------------------------------------------------------
# 4. Watchdog
# ------------------------------------------------------------------------------
# systemd RuntimeWatchdogSec=10 is live on the current firmware
# (recipes-core/systemd-apollo/files/system.conf:27). Built-in so the device
# node exists before any module load can fail. NOTE for whoever carries
# RuntimeWatchdogSec forward: pre-flight check P5 must land first - a watchdog
# reset is diverted to the p7 recovery slot AHEAD of A/B selection by
# check_watchdog, so it is NOT a rollback path (plan risk #1).
CONFIG_MESON_GXBB_WATCHDOG=y            # Armbian stock: =m. Built-in here.

# ------------------------------------------------------------------------------
# 5. LEDs and PWM
# ------------------------------------------------------------------------------
# Three PWM LEDs, labels kept verbatim as apollo:power / apollo:app1 /
# apollo:app2 because led_compose_name() uses props.label as-is for leds-pwm and
# the initramfs writes those sysfs paths by name. Built-in so the LEDs work in
# the initramfs, before the rootfs (and thus any .ko) is available - on a
# headless box in a closet the LEDs are the only out-of-band status channel
# short of opening the case for serial.
CONFIG_LEDS_PWM=y                       # Armbian stock: =m. Built-in so initramfs-stage LED writes work.
CONFIG_PWM_MESON=y                      # Armbian stock: =y already. Invariant only (6.12 dtsi still uses amlogic,meson-axg-ee-pwm).

# ------------------------------------------------------------------------------
# 6. Reset button
# ------------------------------------------------------------------------------
# GPIOAO_10, active low -> KEY_RESTART via a gpio-keys node in the DTS. U-Boot
# reads the same pin as a raw register (setexpr button *0xff800028 & 0x400) and
# is unaffected by Linux either way; this only gives Linux userspace a chance to
# see a short press.
CONFIG_KEYBOARD_GPIO=y                  # Armbian stock: =y already. Invariant only.

# ------------------------------------------------------------------------------
# 7. NAND controller must not exist
# ------------------------------------------------------------------------------
# Mainline gained nand-controller@7800 whose "emmc" reg region IS sd_emmc_c's
# register window, and on v6.12 that node carries no status property, so it
# defaults to okay. Armbian ships MTD_NAND_MESON=m, so meson_nand.ko exists and
# will happily bind to the pads the rootfs lives behind. The DTS disables &nfc;
# this makes the driver unbuildable so there is nothing left to bind. Paired
# with MODULES_BLACKLIST="meson_nand" in board/avast-omni.csc.
# CONFIG_MTD_NAND_MESON is not set      # Armbian stock: =m. Must be n - its reg window overlaps the eMMC controller.

# ------------------------------------------------------------------------------
# 8. Firewalling / VPN - what this migration is actually for
# ------------------------------------------------------------------------------
# All three are already in Armbian's stock config; the 5.4 vendor kernel has
# none of them (no CONFIG_WIREGUARD, no CONFIG_NF_TABLES; iptables-legacy +
# ipset only). Listed so CI notices if an armbian/ submodule bump drops them,
# not because we need to change anything.
CONFIG_NF_TABLES=m                      # Armbian stock: =m already. Absent from the 5.4 vendor kernel entirely.
CONFIG_NFT_COMPAT=m                     # Armbian stock: =m already (also forced =m by armbian-kernel.sh:367). Lets legacy xt_ matches run on the nft engine Docker also uses.
CONFIG_WIREGUARD=m                      # Armbian stock: =m already. Absent from the 5.4 vendor kernel entirely.

# Policy routing, needed by any WireGuard fwmark/table setup. Not a Kconfig
# default; vendor patch 0011 added it on 5.4 and must NOT be forward-ported
# because Armbian already provides it - assert instead of patch.
CONFIG_IPV6_MULTIPLE_TABLES=y           # Armbian stock: =y already. Invariant only (replaces vendor patch 0011).

# ------------------------------------------------------------------------------
# 9. Debug info off
# ------------------------------------------------------------------------------
# !! CANNOT WIN FROM THIS FILE ALONE !!
# armbian_kernel_config__600_enable_ebpf_and_btf_info() (armbian-kernel.sh:112)
# forces DEBUG_INFO / DWARF5 / BTF / BTF_MODULES =y unless KERNEL_BTF="no", and
# it applies that AFTER this file is copied into .config. board/avast-omni.csc
# therefore sets KERNEL_BTF="no"; the lines below are what that produces, kept
# here so the intended end state is written down and CI-checkable.
# Same function also hard-aborts any build host with < 6451 MiB available RAM
# when BTF is on, so KERNEL_BTF=no is a build-host requirement too.
# CONSEQUENCE, ACCEPTED: this also drops BTF/CO-RE. bpftool/Tetragon-style
# CO-RE tooling will not work on this kernel. Nothing in the Omni's workload
# needs it; re-enable by deleting KERNEL_BTF="no" from the board file if that
# ever changes. 5.4 shipped DEBUG_INFO=y (vendor defconfig:334); we do not.
# CONFIG_DEBUG_INFO_DWARF5 is not set   # Armbian stock: =y. Off.
# CONFIG_DEBUG_INFO_BTF is not set      # Armbian stock: =y. Off (kills CO-RE - accepted).
# CONFIG_DEBUG_INFO_BTF_MODULES is not set  # Armbian stock: implied by DEBUG_INFO_BTF=y. Off.
CONFIG_DEBUG_INFO_NONE=y                # Armbian stock: n. DEBUG_INFO is a `select`ed symbol; the only way to turn it off is to pick "none" in the debug-info choice.
# CONFIG_DEBUG_INFO is not set          # Armbian stock: =y (selected by DWARF5). The invariant CI actually asserts.
